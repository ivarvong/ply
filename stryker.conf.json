{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "PROP_N=4 node --test --test-concurrency=1 test/props.test.js test/prefix-closure.test.js test/format-facts.test.js test/mutant-kill.test.js"
  },
  "coverageAnalysis": "off",
  "mutate": ["src/**/*.js"],
  "ignorePatterns": ["reports", ".stryker-tmp", "fuzz-out", "coverage", "worker"],
  "tempDirName": ".stryker-tmp",
  "reporters": ["clear-text", "json", "progress"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 80, "low": 60, "break": 23.54 },
  "timeoutMS": 8000,
  "timeoutFactor": 2,
  "concurrency": 4
}
