{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "tap": {
    "testFiles": ["test/format-facts.test.js", "test/prefix-closure.test.js", "test/props.test.js", "test/mutant-kill.test.js", "test/mutant-kill-tree.test.js", "test/space/push-outcome.test.js"],
    "nodeArgs": ["--env-file=test/stryker.env", "-r", "./test/stryker-parent-guard.cjs", "--test-reporter=tap", "--test-skip-pattern=cells observed from git|every tag of every axis", "-r", "{{hookFile}}", "{{testFile}}"],
    "forceBail": true
  },
  "coverageAnalysis": "perTest",
  "mutate": ["src/**/*.js"],
  "ignorePatterns": ["reports", ".stryker-tmp", "fuzz-out", "coverage"],
  "tempDirName": ".stryker-tmp",
  "reporters": ["clear-text", "json", "progress"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 80, "low": 60, "break": 23.54 },
  "timeoutMS": 8000,
  "timeoutFactor": 2,
  "concurrency": 4
}
